# Скопируйте этот файл в .env и заполните своими данными

# Вариант 1 — токен доступа МойСклад (рекомендуется)
MOYSKLAD_TOKEN=

# Вариант 2 — логин и пароль от аккаунта МойСклад (если токена нет)
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=

# Как часто (в минутах) обновлять список товаров с сервера МойСклад
CACHE_TTL_MINUTES=60

# Порт, на котором запустится сайт
PORT=3000
